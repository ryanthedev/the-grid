#!/bin/zsh
# BFD Shell Wrapper
#
# This script sets up the user's PATH before executing commands from BFD.
# LaunchAgent plists cannot use $HOME or environment variable expansion,
# so this wrapper provides a portable way to include user bin directories.
#
# See: docs/adr/002-bfd-shell-wrapper.md

# Add user bin directories to PATH
export PATH="$HOME/.config/bin:$HOME/.local/bin:$PATH"

# Execute the command
exec /bin/zsh -c "$*"
